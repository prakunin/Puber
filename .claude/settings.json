{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "agent-flow": {
      "source": {
        "source": "directory",
        "path": "/mnt/data/projects/agent-flow"
      }
    }
  },
  "enabledPlugins": {
    "task@agent-flow": true
  }
}
