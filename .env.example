# Local deploy settings for the Makefile. Copy to .env and adjust.
# .env is not tracked, so it stays out of the repository.

# Android TV device adb targets at host:port. Required by every deploy target.
# Enable ADB debugging on the device, then find it with `make devices`.
DEVICE = 192.168.1.100:5555

# dev installs as com.kino.puber.stage next to a release build.
# prod shares com.kino.puber with official releases and will not install over
# one of them: local builds are signed with app/debug.jks, releases are not.
FLAVOR = dev

# Used by build/install/run. Usually debug; `make deploy` overrides this with
# the optimized non-debug deploy build type.
BUILD_TYPE = debug

# Override only if the tools are not on PATH.
# ADB = /opt/homebrew/bin/adb
# GRADLE = ./tools/agentw
